<UserControl
    x:Class="Mimi.App.Views.ConnectView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="360" Margin="24,48,24,24" Spacing="14" HorizontalAlignment="Stretch">
            <Image Source="ms-appx:///Assets/Mimi.png" Width="72" Height="72" HorizontalAlignment="Center" />
            <TextBlock Text="เชื่อมต่อ Mimi" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="{StaticResource MimiInkBrush}" />

            <!-- 1. Which server -->
            <StackPanel Spacing="10" Visibility="{x:Bind ViewModel.OnServer, Mode=OneWay}">
                <TextBlock Style="{StaticResource MimiCaption}" Text="ใส่ที่อยู่เซิร์ฟเวอร์ Mimi ที่ผู้ดูแลให้มา (https://…) หรือ http://localhost:8787 สำหรับ core บนเครื่องนี้" />
                <TextBox x:Name="ServerBox" AutomationProperties.AutomationId="ServerBox" AutomationProperties.Name="ที่อยู่เซิร์ฟเวอร์"
                         PlaceholderText="https://mimi.example.com" Text="{x:Bind ViewModel.ServerText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         IsSpellCheckEnabled="False" KeyDown="OnServerKey" />
                <Button AutomationProperties.AutomationId="CheckButton" Content="ถัดไป" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Stretch"
                        Command="{x:Bind ViewModel.CheckCommand}" IsEnabled="{x:Bind ViewModel.Idle, Mode=OneWay}" />
            </StackPanel>

            <!-- 2a. A single core: its token -->
            <StackPanel Spacing="10" Visibility="{x:Bind ViewModel.OnToken, Mode=OneWay}">
                <TextBlock Style="{StaticResource MimiCaption}" Text="{x:Bind ViewModel.Server, Mode=OneWay}" />
                <TextBlock Style="{StaticResource MimiCaption}" Text="เซิร์ฟเวอร์นี้เป็น core คนเดียว ใส่รหัสผ่านของ Mimi (ค่า MIMI_TOKEN ของเครื่องที่รัน core)" />
                <PasswordBox x:Name="TokenBox" AutomationProperties.AutomationId="TokenBox" AutomationProperties.Name="รหัสผ่านของ Mimi"
                             PlaceholderText="รหัสผ่านของ Mimi" Password="{x:Bind ViewModel.Token, Mode=TwoWay}" KeyDown="OnSignInKey" />
            </StackPanel>

            <!-- 2b. The accounts gateway: username, password, code -->
            <StackPanel Spacing="10" Visibility="{x:Bind ViewModel.OnCredentials, Mode=OneWay}">
                <TextBlock Style="{StaticResource MimiCaption}" Text="{x:Bind ViewModel.Server, Mode=OneWay}" />
                <TextBox AutomationProperties.AutomationId="UserBox" AutomationProperties.Name="ชื่อผู้ใช้" PlaceholderText="ชื่อผู้ใช้"
                         Text="{x:Bind ViewModel.Username, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsSpellCheckEnabled="False" />
                <PasswordBox AutomationProperties.AutomationId="PasswordBox" AutomationProperties.Name="รหัสผ่าน" PlaceholderText="รหัสผ่าน"
                             Password="{x:Bind ViewModel.Password, Mode=TwoWay}" KeyDown="OnSignInKey" />
                <TextBox AutomationProperties.AutomationId="CodeBox" AutomationProperties.Name="รหัสยืนยันตัวตน" PlaceholderText="รหัส 6 หลักจากแอป authenticator"
                         Text="{x:Bind ViewModel.Code, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Visibility="{x:Bind ViewModel.NeedsCode, Mode=OneWay}"
                         InputScope="Number" KeyDown="OnSignInKey" />
            </StackPanel>

            <StackPanel Spacing="10" Visibility="{x:Bind SignInVisible, Mode=OneWay}">
                <CheckBox AutomationProperties.AutomationId="NotMineBox" Content="เครื่องนี้ไม่ใช่ของฉัน (ไม่จำการเข้าสู่ระบบหลังปิดแอป)" IsChecked="{x:Bind ViewModel.NotMyDevice, Mode=TwoWay}" />
                <Button AutomationProperties.AutomationId="SignInButton" Content="เข้าสู่ระบบ" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Stretch"
                        Command="{x:Bind ViewModel.SignInCommand}" IsEnabled="{x:Bind ViewModel.Idle, Mode=OneWay}" />
                <HyperlinkButton Content="เปลี่ยนเซิร์ฟเวอร์" Command="{x:Bind ViewModel.BackCommand}" HorizontalAlignment="Center" />
            </StackPanel>

            <ProgressRing IsActive="{x:Bind ViewModel.Busy, Mode=OneWay}" Width="24" Height="24" />
            <TextBlock AutomationProperties.AutomationId="ConnectError" Text="{x:Bind ViewModel.Error, Mode=OneWay}" Foreground="{StaticResource MimiBadBrush}"
                       TextWrapping="Wrap" Visibility="{x:Bind ViewModel.HasError, Mode=OneWay}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
