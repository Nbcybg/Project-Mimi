<UserControl
    x:Class="Mimi.App.Views.ChatListView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Mimi.Core.ViewModels"
    xmlns:local="using:Mimi.App.Views">
    <!-- The web app's side panel (index.html aside.side): search, chats with their tabs, the pages, the PC agent. -->
    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto,Auto" Background="{StaticResource MimiPanelBrush}">
        <Button Margin="12,10,12,8" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="10,6" CornerRadius="9"
                Background="{StaticResource MimiBgBrush}" BorderBrush="{StaticResource MimiLineBrush}" Click="OnSearch" AutomationProperties.Name="ค้นหาทุกแชต">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="ค้นหาทุกแชต…" FontSize="13" Foreground="{StaticResource MimiMutedBrush}" />
                <Border Grid.Column="1" BorderBrush="{StaticResource MimiLineBrush}" BorderThickness="1,1,1,2" CornerRadius="5" Padding="6,0" Background="{StaticResource MimiRaisedBrush}">
                    <TextBlock Text="Ctrl K" FontFamily="Cascadia Mono, Consolas" FontSize="11" Foreground="{StaticResource MimiInk2Brush}" />
                </Border>
            </Grid>
        </Button>

        <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Padding="16,0,12,4">
            <TextBlock Text="แชต" Style="{StaticResource MimiSectionTitle}" VerticalAlignment="Center" Margin="0" />
            <DropDownButton Grid.Column="1" AutomationProperties.AutomationId="NewChatButton" AutomationProperties.Name="แชตใหม่" IsEnabled="{x:Bind ViewModel.HasAgents, Mode=OneWay}"
                            Padding="10,2" CornerRadius="8" FontSize="12" Background="{StaticResource MimiAccentSoftBrush}" BorderBrush="{StaticResource MimiAccentBrush}"
                            Foreground="{StaticResource MimiAccentTextBrush}" Content="+ ใหม่">
                <DropDownButton.Flyout>
                    <Flyout x:Name="AgentFlyout" Placement="BottomEdgeAlignedRight">
                        <StackPanel>
                            <TextBlock Text="เริ่มคุยกับ" Style="{StaticResource MimiSectionTitle}" />
                            <Button Content="+ สร้างแชตกลุ่ม…" HorizontalAlignment="Stretch" Margin="0,0,0,6" Click="OnNewGroup" AutomationProperties.AutomationId="NewGroupButton" Style="{StaticResource MimiButton}" />
                            <ListView ItemsSource="{x:Bind ViewModel.Agents}" SelectionMode="None" IsItemClickEnabled="True" ItemClick="OnAgentClick" MaxHeight="360" MinWidth="240">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="vm:AgentChoice">
                                        <StackPanel Padding="0,6">
                                            <TextBlock Text="{x:Bind Shown}" FontWeight="SemiBold" />
                                            <TextBlock Text="{x:Bind Description}" Style="{StaticResource MimiCaption}" MaxLines="2" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>
                    </Flyout>
                </DropDownButton.Flyout>
            </DropDownButton>
        </Grid>

        <!-- ตัวต่อตัว / กลุ่ม: the web's segmented tabs. -->
        <Border Grid.Row="2" Margin="12,2,12,6" Padding="3" CornerRadius="10" BorderBrush="{StaticResource MimiLineBrush}" BorderThickness="1" Background="{StaticResource MimiBgBrush}">
            <Grid ColumnDefinitions="*,*" ColumnSpacing="3">
                <ToggleButton AutomationProperties.AutomationId="DirectTab" Content="ตัวต่อตัว" HorizontalAlignment="Stretch" CornerRadius="8" FontSize="12.5" Padding="0,4" BorderThickness="0"
                              IsChecked="{x:Bind ViewModel.ShowingDirect, Mode=OneWay}" Command="{x:Bind ViewModel.ShowDirectCommand}" />
                <ToggleButton Grid.Column="1" AutomationProperties.AutomationId="GroupTab" Content="กลุ่ม" HorizontalAlignment="Stretch" CornerRadius="8" FontSize="12.5" Padding="0,4" BorderThickness="0"
                              IsChecked="{x:Bind ViewModel.ShowingGroups, Mode=OneWay}" Command="{x:Bind ViewModel.ShowGroupsCommand}" />
            </Grid>
        </Border>

        <ListView Grid.Row="3" x:Name="List" AutomationProperties.AutomationId="ChatList" ItemsSource="{x:Bind ViewModel.Rows}" SelectionMode="None"
                  IsItemClickEnabled="True" ItemClick="OnChatClick" Padding="6,0,6,8">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                    <Setter Property="Padding" Value="4,0" />
                    <Setter Property="MinHeight" Value="0" />
                    <Setter Property="CornerRadius" Value="9" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:ChatRow">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" Padding="4,7" AutomationProperties.Name="{x:Bind Title}">
                        <local:Avatar Path="{x:Bind Avatar}" Initial="{x:Bind Initial}" Size="36" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                            <TextBlock Text="{x:Bind Title}" FontSize="13.5" TextTrimming="CharacterEllipsis" Foreground="{StaticResource MimiInkBrush}" />
                            <TextBlock Text="กำลังพิมพ์…" Foreground="{StaticResource MimiAccentTextBrush}" FontSize="12" Visibility="{x:Bind Busy}" />
                            <TextBlock Text="{x:Bind Preview}" Foreground="{StaticResource MimiMutedBrush}" FontSize="12" TextTrimming="CharacterEllipsis" MaxLines="1"
                                       Visibility="{x:Bind local:ChatListView.Not(Busy)}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" VerticalAlignment="Top" HorizontalAlignment="Right" Spacing="4" Padding="0,2,0,0">
                            <TextBlock Text="{x:Bind When}" FontSize="11" Foreground="{StaticResource MimiFaintBrush}" HorizontalAlignment="Right" />
                            <Ellipse Width="8" Height="8" Fill="{StaticResource MimiAccentBrush}" HorizontalAlignment="Right" Visibility="{x:Bind Unread}" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <StackPanel Grid.Row="3" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8" Visibility="{x:Bind ViewModel.Empty, Mode=OneWay}">
            <TextBlock Text="ยังไม่มีแชต" HorizontalAlignment="Center" Foreground="{StaticResource MimiMutedBrush}" />
            <TextBlock Text="กด &quot;+ ใหม่&quot; เพื่อเริ่มคุยกับ agent" Style="{StaticResource MimiCaption}" HorizontalAlignment="Center" />
        </StackPanel>

        <!-- The pages (index.html nav#nav), four to a row. -->
        <Border Grid.Row="4" BorderBrush="{StaticResource MimiLineBrush}" BorderThickness="0,1,0,0" Padding="8">
            <Grid x:Name="Nav" ColumnDefinitions="*,*,*,*" RowDefinitions="Auto,Auto" ColumnSpacing="4" RowSpacing="4" AutomationProperties.AutomationId="Nav" />
        </Border>
        <StackPanel Grid.Row="5" Orientation="Horizontal" Spacing="8" Padding="16,0,16,10">
            <Ellipse x:Name="PcDot" Width="7" Height="7" Fill="{StaticResource MimiFaintBrush}" VerticalAlignment="Center" />
            <TextBlock x:Name="PcText" FontSize="12" Foreground="{StaticResource MimiMutedBrush}" Text="PC agent: ไม่ได้เชื่อมต่อ" TextTrimming="CharacterEllipsis" />
        </StackPanel>
    </Grid>
</UserControl>
