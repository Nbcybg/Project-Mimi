<Project>
  <!-- Shared by every project of the native Windows app (apps/windows/README.md). -->
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <!-- The app's version: pass -p:Version=0.8.1 (the build script takes it from the root package.json). -->
    <Version Condition="'$(Version)' == ''">0.0.0</Version>
    <Product>Mimi</Product>
    <Company>Mimi</Company>
    <Copyright>Mimi</Copyright>
    <NeutralLanguage>th-TH</NeutralLanguage>
  </PropertyGroup>
</Project>
