<UserControl
    x:Class="Mimi.App.Views.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- "This computer": a section of Settings → แอปและระบบ (the tray menu's choices). -->
    <Border Style="{StaticResource MimiCard}">
        <StackPanel Spacing="14">
            <TextBlock Text="เครื่องนี้ (แอป Windows)" Style="{StaticResource MimiSectionTitle}" />

            <StackPanel Spacing="6">
                <TextBlock Text="เครื่องนี้" FontWeight="SemiBold" Foreground="{StaticResource MimiAccentTextBrush}" />
                <ToggleSwitch x:Name="AtLogin" AutomationProperties.AutomationId="AtLogin" Header="เปิด Mimi ตอนเข้าสู่ระบบ Windows" Toggled="OnAtLogin" />
                <ComboBox x:Name="AutoLock" Header="ออกจากระบบอัตโนมัติ" SelectionChanged="OnAutoLock" MinWidth="200" />
                <ToggleSwitch x:Name="HideOnBlur" Header="ซ่อนเมื่อคลิกที่อื่น" Toggled="OnHideOnBlur" />
                <ToggleSwitch x:Name="OnTop" Header="อยู่บนสุดเสมอ" Toggled="OnOnTop" />
            </StackPanel>

            <StackPanel Spacing="6">
                <TextBlock Text="ให้ Mimi ใช้เครื่องนี้ (PC agent)" FontWeight="SemiBold" Foreground="{StaticResource MimiAccentTextBrush}" />
                <TextBlock Style="{StaticResource MimiCaption}" Text="agent บนเซิร์ฟเวอร์อ่าน/เขียนไฟล์ในโฟลเดอร์ที่อนุญาต และเปิดเบราว์เซอร์ (Edge/Chrome) บนเครื่องนี้ได้ คำสั่งที่เสี่ยงยังต้องกดอนุญาตในแชต" />
                <ToggleSwitch x:Name="PcAgent" AutomationProperties.AutomationId="PcAgent" Header="เปิด PC agent" Toggled="OnPcAgent" />
                <TextBlock x:Name="PcStatus" Style="{StaticResource MimiCaption}" />
                <ToggleSwitch x:Name="PcShell" Header="อนุญาตให้รันคำสั่งบนเครื่องนี้ (shell)" Toggled="OnPcShell" />
                <TextBlock Text="โฟลเดอร์ที่ Mimi ใช้ได้" Style="{StaticResource MimiCaption}" />
                <ListView x:Name="Folders" SelectionMode="Single" MaxHeight="160" BorderBrush="{StaticResource MimiLineBrush}" BorderThickness="1" CornerRadius="6" />
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <Button Content="เพิ่มโฟลเดอร์…" Click="OnAddFolder" />
                    <Button Content="เอาออก" Click="OnRemoveFolder" />
                </StackPanel>
                <Button Content="เปิดเบราว์เซอร์ของ Mimi" Click="OnOpenAgentBrowser" Style="{StaticResource MimiGhostButton}"
                        ToolTipService.ToolTip="Edge/Chrome ด้วยโปรไฟล์ของ agent — ล็อกอินเว็บที่ให้ agent ใช้ไว้ที่นี่ (เก็บไว้หลังปิด)" />
            </StackPanel>

            <StackPanel Spacing="6">
                <TextBlock Text="แอป" FontWeight="SemiBold" Foreground="{StaticResource MimiAccentTextBrush}" />
                <TextBlock x:Name="Version" Style="{StaticResource MimiCaption}" />
                <Button x:Name="Update" Content="อัปเดต" Visibility="Collapsed" Style="{StaticResource AccentButtonStyle}" Click="OnUpdate" />
                <Button Content="เปิด Mimi ในเบราว์เซอร์" Click="OnOpenWeb" Style="{StaticResource MimiGhostButton}" />
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
