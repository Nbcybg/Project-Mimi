# --- Model providers ---------------------------------------------------------
# The usual way is the app's settings screen: add a provider (name + URL + API key),
# the app lists its models and stores the credential in user/data/auth.json.
# Keys set here work too, for providers known to models.dev (e.g. OPENCODE_API_KEY).
DEEPSEEK_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
ANTHROPIC_API_KEY=

# --- Server (npm run serve) --------------------------------------------------
# Shared secret for every client and the PC agent. Leave empty for a one-time token
# that is printed at start. Use a long random value when the core is reachable from
# outside this machine.
MIMI_TOKEN=
# MIMI_HOST=127.0.0.1      # 0.0.0.0 to accept connections from other devices
# PORT=8787

# --- Files and shell ---------------------------------------------------------
# Folders the file/shell tools may touch, separated by ";". Defaults to ./user/workspace
ALLOWED_DIRS=
# Set to 0 on a cloud core: file/shell tools then only work through a connected PC agent.
# MIMI_LOCAL_PC_TOOLS=1

# --- PC agent (npm run pc-agent, on your own computer) ------------------------
# Uses MIMI_TOKEN and ALLOWED_DIRS from above, plus where the core is:
# MIMI_CORE_URL=ws://127.0.0.1:8787/ws

# --- Gmail and Google Calendar ------------------------------------------------
# Create a "Desktop app" OAuth client in Google Cloud Console, paste the two values
# here, then run:  npm run google-auth
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Optional: instead of the token file written by google-auth
# GOOGLE_OAUTH_REFRESH_TOKEN=

# --- Outlook mail, Outlook calendar, Microsoft To Do ---------------------------
# Usually set in the app (Settings). Register your own app in Azure Portal ->
# App registrations, add the platform "Mobile and desktop applications" with the
# redirect URI http://localhost, and use its Application (client) ID. No secret needed.
# MICROSOFT_CLIENT_ID=
# MICROSOFT_TENANT=common

# --- Web tools ------------------------------------------------------------------
# Usually set in the app (Settings -> tool keys).
# SERPER_API_KEY=           # web_search and map_search (serper.dev)
# OPENWEATHER_API_KEY=      # weather (openweathermap.org)

# --- Optional overrides ---------------------------------------------------------
# MIMI_CONFIG=mimi.json
# MIMI_DB=user/data/mimi.db
# MIMI_TIMEZONE=Asia/Bangkok
# PERMISSION_TIMEOUT_MS=120000
# MIMI_MODELS_OFFLINE=1   # never download the models.dev catalog, use the cached copy only
