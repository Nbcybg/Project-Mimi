<UserControl
    x:Class="Mimi.App.Views.MimiampView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Mimi.Core.ViewModels"
    RequestedTheme="Dark">
    <!-- The web's Mimiamp "blue edition" skin (app.css .amp-*): one window of three zones — player, equalizer, playlist. -->
    <UserControl.Resources>
        <SolidColorBrush x:Key="AmpFace" Color="#FF17293D" />
        <SolidColorBrush x:Key="AmpLow" Color="#FF050C15" />
        <SolidColorBrush x:Key="AmpInk" Color="#FFDCEAF7" />
        <SolidColorBrush x:Key="AmpDim" Color="#FF8BA7C2" />
        <SolidColorBrush x:Key="AmpGreen" Color="#FF47D7FF" />
        <SolidColorBrush x:Key="AmpGreenDim" Color="#FF2C87B5" />
        <SolidColorBrush x:Key="AmpLcd" Color="#FF061526" />
        <SolidColorBrush x:Key="AmpArtist" Color="#FF4B8FBE" />
        <LinearGradientBrush x:Key="AmpButtonFace" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#FF3A5F86" Offset="0" />
            <GradientStop Color="#FF1C3149" Offset="0.56" />
            <GradientStop Color="#FF122235" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="AmpTitleBar" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#FF2B4A6C" Offset="0" />
            <GradientStop Color="#FF173049" Offset="1" />
        </LinearGradientBrush>
        <Style x:Key="AmpButton" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="Background" Value="{StaticResource AmpButtonFace}" />
            <Setter Property="Foreground" Value="{StaticResource AmpInk}" />
            <Setter Property="BorderBrush" Value="{StaticResource AmpLow}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="2" />
            <Setter Property="Padding" Value="7,3" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontFamily" Value="Cascadia Mono, Consolas" />
        </Style>
        <Style x:Key="AmpToggle" TargetType="ToggleButton" BasedOn="{StaticResource DefaultToggleButtonStyle}">
            <Setter Property="Background" Value="{StaticResource AmpButtonFace}" />
            <Setter Property="Foreground" Value="{StaticResource AmpInk}" />
            <Setter Property="BorderBrush" Value="{StaticResource AmpLow}" />
            <Setter Property="CornerRadius" Value="2" />
            <Setter Property="Padding" Value="7,3" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontFamily" Value="Cascadia Mono, Consolas" />
        </Style>
        <Style x:Key="AmpZone" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Cascadia Mono, Consolas" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="CharacterSpacing" Value="120" />
            <Setter Property="Foreground" Value="{StaticResource AmpGreen}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="AmpSmall" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Cascadia Mono, Consolas" />
            <Setter Property="FontSize" Value="9.5" />
            <Setter Property="CharacterSpacing" Value="60" />
            <Setter Property="Foreground" Value="{StaticResource AmpGreenDim}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <Grid Background="#FF0B1420" Padding="8">
        <Border Background="{StaticResource AmpFace}" BorderBrush="{StaticResource AmpLow}" BorderThickness="1" CornerRadius="3">
            <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">
                <!-- The window's title bar. -->
                <Grid Background="{StaticResource AmpTitleBar}" Padding="8,5" ColumnDefinitions="Auto,*">
                    <TextBlock Text="MIMIAMP" FontSize="10.5" FontWeight="Bold" CharacterSpacing="240" Foreground="#FFE6F5FF" />
                    <TextBlock Grid.Column="1" Text="BLUE EDITION · BACKGROUND MUSIC" HorizontalAlignment="Right" FontFamily="Cascadia Mono, Consolas" FontSize="9.5"
                               CharacterSpacing="60" Foreground="#FF88A8C4" TextTrimming="CharacterEllipsis" />
                </Grid>

                <!-- PLAYER -->
                <StackPanel Grid.Row="1" Padding="8,6,8,8" Spacing="6" BorderBrush="{StaticResource AmpLow}" BorderThickness="0,0,0,1">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="PLAYER" Style="{StaticResource AmpZone}" />
                        <TextBlock Grid.Column="1" Text="AUDIO ONLY" Style="{StaticResource AmpSmall}" />
                    </Grid>
                    <Border Background="{StaticResource AmpLcd}" BorderBrush="{StaticResource AmpLow}" BorderThickness="1" CornerRadius="2" Padding="8,6">
                        <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,Auto" RowSpacing="4">
                            <StackPanel Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="8">
                                <Border x:Name="StateBadge" Background="{StaticResource AmpGreen}" CornerRadius="2" Padding="5,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="StateBadgeText" Text="STOP" FontFamily="Cascadia Mono, Consolas" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource AmpLcd}" />
                                </Border>
                                <TextBlock AutomationProperties.AutomationId="NowTitle" Text="{x:Bind NowTitleOrHint, Mode=OneWay}" FontFamily="Cascadia Mono, Consolas" FontSize="12"
                                           FontWeight="SemiBold" Foreground="{StaticResource AmpGreen}" TextTrimming="CharacterEllipsis" MaxWidth="300" />
                            </StackPanel>
                            <TextBlock Grid.Row="1" x:Name="BigClock" Text="0:00" FontFamily="Cascadia Mono, Consolas" FontSize="28" FontWeight="Bold" Foreground="{StaticResource AmpGreen}" />
                            <StackPanel Grid.Row="1" Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind ViewModel.NowDetail, Mode=OneWay}" Style="{StaticResource AmpSmall}" HorizontalAlignment="Right" MaxWidth="170" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="MIMIAMP 2.0" Style="{StaticResource AmpSmall}" HorizontalAlignment="Right" />
                            </StackPanel>
                            <!-- The visualizer (analyser bars). -->
                            <Grid Grid.Row="1" Grid.ColumnSpan="2" Margin="96,0,104,0" Height="30" VerticalAlignment="Bottom">
                                <Grid x:Name="Bars" ColumnSpacing="2" VerticalAlignment="Stretch" />
                            </Grid>
                            <Grid Grid.Row="2" Grid.ColumnSpan="2" ColumnDefinitions="*,Auto">
                                <TextBlock x:Name="StatusText" Text="STOPPED" Style="{StaticResource AmpSmall}" />
                                <TextBlock Grid.Column="1" x:Name="CountText" Style="{StaticResource AmpSmall}" />
                            </Grid>
                        </Grid>
                    </Border>
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="7">
                        <TextBlock AutomationProperties.AutomationId="Clock" Text="{x:Bind ViewModel.Clock, Mode=OneWay}" FontFamily="Cascadia Mono, Consolas" FontSize="10"
                                   Foreground="{StaticResource AmpDim}" VerticalAlignment="Center" />
                        <Slider x:Name="Seek" Grid.Column="1" AutomationProperties.Name="ตำแหน่งเพลง" Minimum="0" Maximum="{x:Bind ViewModel.DurationSeconds, Mode=OneWay}"
                                Value="{x:Bind ViewModel.PositionSeconds, Mode=OneWay}" IsThumbToolTipEnabled="False" PointerCaptureLost="OnSeekReleased" KeyUp="OnSeekKey" />
                        <ProgressRing Grid.Column="2" IsActive="{x:Bind ViewModel.Preparing, Mode=OneWay}" Width="14" Height="14" Foreground="{StaticResource AmpGreen}" />
                    </Grid>
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="2">
                            <Button Style="{StaticResource AmpButton}" Content="|&#x25C0;" AutomationProperties.Name="ก่อนหน้า" Command="{x:Bind ViewModel.PreviousCommand}" />
                            <Button AutomationProperties.AutomationId="PlayButton" Style="{StaticResource AmpButton}" Content="{x:Bind PlaySymbol, Mode=OneWay}"
                                    AutomationProperties.Name="เล่น/หยุด" Command="{x:Bind ViewModel.ToggleCommand}" MinWidth="30" />
                            <Button Style="{StaticResource AmpButton}" Content="&#x25A0;" AutomationProperties.Name="หยุด" Command="{x:Bind ViewModel.StopPlayingCommand}" />
                            <Button Style="{StaticResource AmpButton}" Content="&#x25B6;|" AutomationProperties.Name="ถัดไป" Command="{x:Bind ViewModel.NextCommand}" />
                        </StackPanel>
                        <Grid Grid.Column="1" ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" ColumnSpacing="4">
                            <TextBlock Text="VOL" FontFamily="Cascadia Mono, Consolas" FontSize="9" Foreground="{StaticResource AmpDim}" VerticalAlignment="Center" />
                            <Slider Grid.Column="1" AutomationProperties.Name="ความดัง" Minimum="0" Maximum="100" Value="{x:Bind ViewModel.VolumeLevel, Mode=TwoWay}" Margin="0,-6" />
                            <TextBlock Grid.Row="1" Text="PAN" FontFamily="Cascadia Mono, Consolas" FontSize="9" Foreground="{StaticResource AmpDim}" VerticalAlignment="Center" />
                            <Slider Grid.Row="1" Grid.Column="1" AutomationProperties.AutomationId="Pan" AutomationProperties.Name="ซ้าย/ขวา" Minimum="-100" Maximum="100"
                                    Value="{x:Bind ViewModel.Pan, Mode=TwoWay}" Margin="0,-6" DoubleTapped="OnPanCentre" ToolTipService.ToolTip="ซ้าย/ขวา (ดับเบิลคลิก = ตรงกลาง)" />
                        </Grid>
                        <StackPanel Grid.Column="2" Spacing="2" VerticalAlignment="Center">
                            <ToggleButton Style="{StaticResource AmpToggle}" Content="SHUF" AutomationProperties.Name="สุ่ม" IsChecked="{x:Bind ViewModel.Shuffle, Mode=TwoWay}" />
                            <Button Style="{StaticResource AmpButton}" Content="{x:Bind RepeatShort, Mode=OneWay}" FontSize="10.5" FontWeight="Bold" AutomationProperties.Name="วน"
                                    ToolTipService.ToolTip="{x:Bind ViewModel.RepeatLabel, Mode=OneWay}" Command="{x:Bind ViewModel.CycleRepeatCommand}" />
                        </StackPanel>
                    </Grid>
                    <TextBlock AutomationProperties.AutomationId="MusicError" Text="{x:Bind ViewModel.Error, Mode=OneWay}" Foreground="#FFF08995" FontSize="11.5" TextWrapping="Wrap" />
                </StackPanel>

                <!-- EQUALIZER (feature-mimiamp.js EQ_BANDS) -->
                <StackPanel Grid.Row="2" Padding="8,6,8,8" Spacing="6" BorderBrush="{StaticResource AmpLow}" BorderThickness="0,0,0,1">
                    <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="6">
                        <TextBlock Text="EQUALIZER" Style="{StaticResource AmpZone}" />
                        <ComboBox Grid.Column="1" x:Name="PresetBox" PlaceholderText="Flat" ItemsSource="{x:Bind ViewModel.Presets}" SelectionChanged="OnPreset"
                                  HorizontalAlignment="Stretch" FontSize="11" MinHeight="0" Padding="8,2" Background="#FF0D1B2B" BorderBrush="{StaticResource AmpLow}" />
                        <ToggleButton Grid.Column="2" AutomationProperties.AutomationId="EqButton" Style="{StaticResource AmpToggle}" Content="{x:Bind EqLabel, Mode=OneWay}"
                                      IsChecked="{x:Bind ViewModel.EqEnabled, Mode=TwoWay}" ToolTipService.ToolTip="เปิด/ปิด EQ" />
                        <ToggleButton Grid.Column="3" Style="{StaticResource AmpToggle}" Content="&#x25BE;" IsChecked="{x:Bind EqOpen, Mode=TwoWay}" ToolTipService.ToolTip="แสดง/ซ่อนแถบ EQ" />
                    </Grid>
                    <Grid x:Name="Bands" Height="132" ColumnSpacing="2" Visibility="{x:Bind EqOpen, Mode=OneWay}" />
                </StackPanel>

                <!-- PLAYLIST -->
                <Grid Grid.Row="3" RowDefinitions="Auto,Auto,*" Padding="8,6,8,4" RowSpacing="6">
                    <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="4">
                        <TextBlock Text="PLAYLIST" Style="{StaticResource AmpZone}" />
                        <TextBlock Grid.Column="1" x:Name="TrackCount" Style="{StaticResource AmpSmall}" HorizontalAlignment="Right" Margin="0,0,4,0" />
                        <Button Grid.Column="2" Style="{StaticResource AmpButton}" Content="YT" ToolTipService.ToolTip="เพิ่มเพลงจากลิงก์ YouTube" AutomationProperties.Name="เพิ่มจาก YouTube">
                            <Button.Flyout>
                                <Flyout>
                                    <StackPanel Spacing="8" Width="260">
                                        <TextBox PlaceholderText="วางลิงก์ YouTube เพื่อเพิ่ม" Text="{x:Bind ViewModel.YoutubeText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsSpellCheckEnabled="False" />
                                        <Button Content="เพิ่ม" Style="{StaticResource AccentButtonStyle}" Command="{x:Bind ViewModel.AddYoutubeCommand}" />
                                    </StackPanel>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                        <Button Grid.Column="3" Style="{StaticResource AmpButton}" Content="เปิดไฟล์" AutomationProperties.AutomationId="OpenLocal" ToolTipService.ToolTip="เพิ่มเพลงจากเครื่องนี้ (เล่นจากไฟล์ ไม่ผ่านเซิร์ฟเวอร์)" Click="OnOpenFiles" />
                        <Button Grid.Column="4" Style="{StaticResource AmpButton}" Content="&#x21BB;" AutomationProperties.Name="โหลดใหม่" Command="{x:Bind ViewModel.RefreshCommand}" />
                    </Grid>
                    <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="3">
                        <ComboBox x:Name="ListBox" HorizontalAlignment="Stretch" FontSize="11.5" MinHeight="0" Padding="8,2" Background="#FF0D1B2B" BorderBrush="{StaticResource AmpLow}"
                                  AutomationProperties.Name="เพลย์ลิสต์" SelectionChanged="OnListChosen" />
                        <Button Grid.Column="1" Style="{StaticResource AmpButton}" Content="+" ToolTipService.ToolTip="เพลย์ลิสต์ใหม่" AutomationProperties.Name="เพลย์ลิสต์ใหม่">
                            <Button.Flyout>
                                <Flyout x:Name="NewPlaylistFlyout">
                                    <StackPanel Spacing="8" Width="220">
                                        <TextBox x:Name="PlaylistName" PlaceholderText="ชื่อเพลย์ลิสต์" />
                                        <Button Content="สร้าง" Style="{StaticResource AccentButtonStyle}" Click="OnNewPlaylist" />
                                    </StackPanel>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                        <Button Grid.Column="2" Style="{StaticResource AmpButton}" Content="&#x270E;" ToolTipService.ToolTip="เปลี่ยนชื่อเพลย์ลิสต์" Click="OnRenamePlaylist" />
                        <Button Grid.Column="3" Style="{StaticResource AmpButton}" Content="&#x2715;" ToolTipService.ToolTip="ลบเพลย์ลิสต์" Click="OnDeletePlaylist" />
                        <Button Grid.Column="4" Style="{StaticResource AmpButton}" Content="นำเข้า" ToolTipService.ToolTip="นำเข้าเพลย์ลิสต์ (.json)" Click="OnImportPlaylist" />
                        <Button Grid.Column="5" Style="{StaticResource AmpButton}" Content="ส่งออก" ToolTipService.ToolTip="ส่งออกเพลย์ลิสต์ (.json)" Click="OnExportPlaylist" />
                    </Grid>
                    <ListView Grid.Row="2" x:Name="TrackList" AutomationProperties.AutomationId="Tracks" ItemsSource="{x:Bind ViewModel.Tracks}"
                              SelectionMode="None" IsItemClickEnabled="True" ItemClick="OnTrack" Background="#FF0A1624" BorderBrush="{StaticResource AmpLow}" BorderThickness="1"
                              AllowDrop="True" DragOver="OnFilesDragOver" Drop="OnFilesDrop">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                                <Setter Property="Padding" Value="6,0" />
                                <Setter Property="MinHeight" Value="26" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:TrackRow">
                                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8" Padding="0,3" AutomationProperties.Name="{x:Bind Title}">
                                    <Grid.ContextFlyout>
                                        <MenuFlyout Opening="OnTrackMenu" />
                                    </Grid.ContextFlyout>
                                    <TextBlock Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" FontFamily="Cascadia Mono, Segoe UI" FontSize="12" Foreground="#FFDCEAF7" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind Detail}" FontSize="11" Foreground="#FF4B8FBE" MaxWidth="110" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="2" Text="{x:Bind Length}" FontFamily="Cascadia Mono, Consolas" FontSize="10.5" Foreground="#FF4B8FBE" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>

                <Grid Grid.Row="4" Padding="8,3" BorderBrush="#1A47D7FF" BorderThickness="0,1,0,0" ColumnDefinitions="*,Auto">
                    <TextBlock Text="คลิกขวาที่เพลง = เพิ่มในเพลย์ลิสต์ · ลากไฟล์เพลงมาวางได้" FontSize="10" Foreground="#FF6D8198" TextTrimming="CharacterEllipsis" />
                    <ToggleButton Grid.Column="1" Style="{StaticResource AmpToggle}" Content="VIS" FontSize="9" Padding="5,1" IsChecked="{x:Bind ViewModel.Visualizer, Mode=TwoWay}"
                                  ToolTipService.ToolTip="แถบภาพเสียง" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
