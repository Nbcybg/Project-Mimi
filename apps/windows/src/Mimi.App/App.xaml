<Application
    x:Class="Mimi.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RequestedTheme="Dark">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- The web app's dark palette (packages/core/src/server/web/app.css :root), as on Android (core/ui Theme.kt). -->
            <Color x:Key="MimiBg">#FF171215</Color>
            <Color x:Key="MimiPanel">#FF20191E</Color>
            <Color x:Key="MimiRaised">#FF2A2027</Color>
            <Color x:Key="MimiLine">#FF40303A</Color>
            <Color x:Key="MimiInk">#FFF2E7EC</Color>
            <Color x:Key="MimiInk2">#FFD2BEC8</Color>
            <Color x:Key="MimiMuted">#FFA48B97</Color>
            <Color x:Key="MimiFaint">#FF7A6470</Color>
            <Color x:Key="MimiAccent">#FFE08AA7</Color>
            <Color x:Key="MimiAccentInk">#FF2A121B</Color>
            <Color x:Key="MimiAccentText">#FFF2AEC3</Color>
            <Color x:Key="MimiOk">#FF7FCF9F</Color>
            <Color x:Key="MimiWarn">#FFE1B96C</Color>
            <Color x:Key="MimiBad">#FFF08995</Color>
            <Color x:Key="MimiInfo">#FF8DB8E8</Color>
            <Color x:Key="MimiUserBg">#FF3B2733</Color>
            <Color x:Key="MimiUserLine">#FF563746</Color>
            <Color x:Key="MimiCode">#FF120E11</Color>
            <Color x:Key="MimiAct">#FFD6B98C</Color>

            <SolidColorBrush x:Key="MimiBgBrush" Color="{StaticResource MimiBg}" />
            <SolidColorBrush x:Key="MimiPanelBrush" Color="{StaticResource MimiPanel}" />
            <SolidColorBrush x:Key="MimiRaisedBrush" Color="{StaticResource MimiRaised}" />
            <SolidColorBrush x:Key="MimiLineBrush" Color="{StaticResource MimiLine}" />
            <SolidColorBrush x:Key="MimiInkBrush" Color="{StaticResource MimiInk}" />
            <SolidColorBrush x:Key="MimiInk2Brush" Color="{StaticResource MimiInk2}" />
            <SolidColorBrush x:Key="MimiMutedBrush" Color="{StaticResource MimiMuted}" />
            <SolidColorBrush x:Key="MimiFaintBrush" Color="{StaticResource MimiFaint}" />
            <SolidColorBrush x:Key="MimiAccentBrush" Color="{StaticResource MimiAccent}" />
            <SolidColorBrush x:Key="MimiAccentInkBrush" Color="{StaticResource MimiAccentInk}" />
            <SolidColorBrush x:Key="MimiAccentTextBrush" Color="{StaticResource MimiAccentText}" />
            <SolidColorBrush x:Key="MimiOkBrush" Color="{StaticResource MimiOk}" />
            <SolidColorBrush x:Key="MimiWarnBrush" Color="{StaticResource MimiWarn}" />
            <SolidColorBrush x:Key="MimiBadBrush" Color="{StaticResource MimiBad}" />
            <SolidColorBrush x:Key="MimiInfoBrush" Color="{StaticResource MimiInfo}" />
            <SolidColorBrush x:Key="MimiUserBrush" Color="{StaticResource MimiUserBg}" />
            <SolidColorBrush x:Key="MimiUserLineBrush" Color="{StaticResource MimiUserLine}" />
            <SolidColorBrush x:Key="MimiCodeBrush" Color="{StaticResource MimiCode}" />
            <SolidColorBrush x:Key="MimiActBrush" Color="{StaticResource MimiAct}" />
            <!-- Recoloured in place by Services/Theme.cs when the theme changes. -->
            <SolidColorBrush x:Key="MimiHoverBrush" Color="#FF33262F" />
            <SolidColorBrush x:Key="MimiLineSoftBrush" Color="#FF2E242C" />
            <SolidColorBrush x:Key="MimiLineStrongBrush" Color="#FF4B3844" />
            <SolidColorBrush x:Key="MimiAccentSoftBrush" Color="#24E08AA7" />
            <SolidColorBrush x:Key="MimiVioletBrush" Color="#FFC3A6F2" />
            <SolidColorBrush x:Key="MimiGlassBrush" Color="#D6141115" />
            <SolidColorBrush x:Key="MimiGlassUserBrush" Color="#F03B2733" />
            <!-- The character chat (web .solo): brushes recoloured in place by ChatView when it opens/closes. -->
            <SolidColorBrush x:Key="MimiGlassButtonBrush" Color="#29FFFFFF" />
            <SolidColorBrush x:Key="MimiGlassButtonLineBrush" Color="#4DFFFFFF" />
            <SolidColorBrush x:Key="MimiGlassInkBrush" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="MimiGlassPanelBrush" Color="#7314161C" />
            <SolidColorBrush x:Key="MimiSoloInputBrush" Color="#9E1C141A" />
            <SolidColorBrush x:Key="MimiChatTxBrush" Color="{StaticResource MimiPanel}" />
            <SolidColorBrush x:Key="MimiChatTxLineBrush" Color="{StaticResource MimiLine}" />
            <SolidColorBrush x:Key="MimiChatUserBrush" Color="{StaticResource MimiUserBg}" />
            <SolidColorBrush x:Key="MimiChatUserLineBrush" Color="{StaticResource MimiUserLine}" />
            <SolidColorBrush x:Key="MimiChatInkBrush" Color="{StaticResource MimiInk}" />
            <SolidColorBrush x:Key="MimiChatUserInkBrush" Color="{StaticResource MimiInk}" />
            <SolidColorBrush x:Key="MimiChatTimeBrush" Color="{StaticResource MimiFaint}" />
            <SolidColorBrush x:Key="MimiChatUserTimeBrush" Color="{StaticResource MimiFaint}" />

            <Style x:Key="MimiGlassCircleButton" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Width" Value="44" />
                <Setter Property="Height" Value="44" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="CornerRadius" Value="22" />
                <Setter Property="Background" Value="{StaticResource MimiGlassButtonBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource MimiGlassButtonLineBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Foreground" Value="{StaticResource MimiGlassInkBrush}" />
                <Setter Property="FontSize" Value="18" />
            </Style>

            <!-- Fluent's accent in Mimi's pink: buttons, toggles, sliders, focus. -->
            <Color x:Key="SystemAccentColor">#FFE08AA7</Color>
            <Color x:Key="SystemAccentColorLight1">#FFE89BB4</Color>
            <Color x:Key="SystemAccentColorLight2">#FFF2AEC3</Color>
            <Color x:Key="SystemAccentColorLight3">#FFF7C6D5</Color>
            <Color x:Key="SystemAccentColorDark1">#FFC9718F</Color>
            <Color x:Key="SystemAccentColorDark2">#FFA85A75</Color>
            <Color x:Key="SystemAccentColorDark3">#FF83445B</Color>

            <Style x:Key="MimiHeaderButton" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="8,6" />
                <Setter Property="MinWidth" Value="36" />
                <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
                <Setter Property="FontSize" Value="15" />
            </Style>

            <!-- The web's buttons: .btn (outlined), .btn.pri (pink), .btn.ghost, and .seg pills. -->
            <Style x:Key="MimiButton" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Background" Value="{StaticResource MimiRaisedBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource MimiLineBrush}" />
                <Setter Property="Foreground" Value="{StaticResource MimiInkBrush}" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="11,5" />
                <Setter Property="FontSize" Value="13" />
            </Style>
            <Style x:Key="MimiPrimaryButton" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="12,5" />
                <Setter Property="FontSize" Value="13" />
            </Style>
            <Style x:Key="MimiGhostButton" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="{StaticResource MimiLineBrush}" />
                <Setter Property="Foreground" Value="{StaticResource MimiInk2Brush}" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="10,4" />
                <Setter Property="FontSize" Value="12.5" />
            </Style>
            <Style x:Key="MimiPill" TargetType="ToggleButton" BasedOn="{StaticResource DefaultToggleButtonStyle}">
                <Setter Property="CornerRadius" Value="14" />
                <Setter Property="Padding" Value="12,4" />
                <Setter Property="FontSize" Value="12.5" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="{StaticResource MimiLineBrush}" />
                <Setter Property="BorderThickness" Value="1" />
            </Style>
            <Style x:Key="MimiCard" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource MimiPanelBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource MimiLineBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="Padding" Value="14,12" />
            </Style>
            <Style x:Key="MimiSectionTitle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="CharacterSpacing" Value="60" />
                <Setter Property="Foreground" Value="{StaticResource MimiFaintBrush}" />
                <Setter Property="Margin" Value="0,0,0,4" />
            </Style>

            <Style x:Key="MimiCaption" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="{StaticResource MimiMutedBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
