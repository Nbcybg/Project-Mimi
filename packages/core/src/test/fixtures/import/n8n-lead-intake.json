{
  "name": "Lead intake",
  "nodes": [
    {
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 0],
      "parameters": {
        "httpMethod": "POST",
        "path": "lead-intake",
        "options": {}
      }
    },
    {
      "name": "Fetch profile",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [240, 0],
      "parameters": {
        "method": "GET",
        "url": "https://api.example.com/v1/leads/{{ $json.body.id }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer demo-placeholder-token-not-real"
            },
            {
              "name": "Accept",
              "value": "application/json"
            }
          ]
        },
        "options": {}
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "cred-demo",
          "name": "Demo API"
        }
      }
    },
    {
      "name": "Send email",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [480, 0],
      "parameters": {
        "operation": "send",
        "sendTo": "={{ $json.body.email }}",
        "subject": "Thanks for signing up",
        "message": "Hi {{ $json.body.name }}, we received your request."
      }
    },
    {
      "name": "Log lead",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [720, 0],
      "parameters": {
        "operation": "append",
        "documentId": {
          "value": "sheet-demo",
          "cachedResultName": "Leads"
        },
        "sheetName": {
          "value": "Sheet1",
          "cachedResultName": "Sheet1"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {}
        }
      }
    },
    {
      "name": "Notify Slack",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.2,
      "position": [960, 0],
      "parameters": {
        "resource": "message",
        "operation": "post",
        "channel": "#leads",
        "text": "New lead from {{ $json.body.name }}"
      }
    },
    {
      "name": "Done",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [1200, 0],
      "parameters": {}
    }
  ],
  "connections": {
    "Webhook": {
      "main": [
        [
          {
            "node": "Fetch profile",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch profile": {
      "main": [
        [
          {
            "node": "Send email",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Send email": {
      "main": [
        [
          {
            "node": "Log lead",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Log lead": {
      "main": [
        [
          {
            "node": "Notify Slack",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Notify Slack": {
      "main": [
        [
          {
            "node": "Done",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "pinData": {},
  "meta": {
    "templateCredsSetupCompleted": false
  }
}
