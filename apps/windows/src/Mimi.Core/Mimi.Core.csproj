       reducer, the updater checks and the view models. Tested on plain .NET. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>Mimi.Core</RootNamespace>
    <AssemblyName>Mimi.Core</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.14" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Mimi.Core.Tests" />
  </ItemGroup>
</Project>
