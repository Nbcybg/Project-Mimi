<UserControl
    x:Class="Mimi.App.Views.ChatView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Mimi.Core.ViewModels"
    xmlns:core="using:Mimi.Core.Protocol"
    xmlns:controls="using:Mimi.App.Controls"
    xmlns:local="using:Mimi.App.Views"
    AllowDrop="True" DragOver="OnDragOver" Drop="OnDrop">
    <UserControl.Resources>
        <DataTemplate x:Key="TextPartTemplate" x:DataType="x:String">
            <controls:MessageText Text="{x:Bind}" TextSize="{x:Bind local:ChatView.ChatTextSize()}" />
        </DataTemplate>

        <DataTemplate x:Key="ToolPartTemplate" x:DataType="vm:ToolRow">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6" Padding="8,4" Margin="0,2" Background="{StaticResource MimiCodeBrush}" CornerRadius="6"
                  Visibility="{x:Bind local:ChatView.PromptVisibility()}">
                <TextBlock Text="{x:Bind Mark}" Foreground="{StaticResource MimiOkBrush}" FontFamily="Segoe UI Symbol" />
                <StackPanel Grid.Column="1">
                    <TextBlock FontSize="12" Foreground="{StaticResource MimiInk2Brush}" TextTrimming="CharacterEllipsis">
                        <Run Text="{x:Bind Name}" FontWeight="SemiBold" /><Run Text=" " /><Run Text="{x:Bind Risk}" Foreground="{StaticResource MimiWarnBrush}" />
                    </TextBlock>
                    <TextBlock Text="{x:Bind Arg}" FontSize="11" Foreground="{StaticResource MimiMutedBrush}" TextTrimming="CharacterEllipsis" MaxLines="2" TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="FileTemplate" x:DataType="vm:FileItem">
            <controls:AttachmentView File="{x:Bind}" />
        </DataTemplate>

        <local:PartSelector x:Key="PartSelector" Text="{StaticResource TextPartTemplate}" Tool="{StaticResource ToolPartTemplate}" File="{StaticResource FileTemplate}" />
        <!-- A message stored on the server. -->
        <DataTemplate x:Key="MessageTemplate" x:DataType="vm:MessageItem">
            <Grid Margin="0,6" MaxWidth="840">
                <Grid HorizontalAlignment="{x:Bind local:ChatView.Side(IsUser)}" MaxWidth="680">
                <StackPanel Spacing="3" HorizontalAlignment="{x:Bind local:ChatView.Side(IsUser)}">
                    <Border Background="{x:Bind local:ChatView.Bubble(IsUser)}" BorderBrush="{x:Bind local:ChatView.BubbleLine(IsUser)}" BorderThickness="1"
                            CornerRadius="{x:Bind local:ChatView.BubbleRadius(IsUser)}" Padding="{x:Bind local:ChatView.BubblePadding(IsUser)}" Tag="{x:Bind}" ContextRequested="OnMessageContext" Tapped="OnMessageTapped">
                        <StackPanel Spacing="6">
                            <StackPanel Orientation="Horizontal" Spacing="8" Visibility="{x:Bind local:ChatView.NameRow(IsUser)}">
                                <TextBlock Text="{x:Bind Who}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource MimiAccentTextBrush}" />
                                <TextBlock Text="{x:Bind Mood}" FontSize="12" Foreground="{StaticResource MimiMutedBrush}" />
                            </StackPanel>
                            <TextBlock Text="{x:Bind Forwarded}" Style="{StaticResource MimiCaption}" FontStyle="Italic" Visibility="{x:Bind HasForwarded}" />
                            <Border BorderBrush="{StaticResource MimiAccentBrush}" BorderThickness="2,0,0,0" Background="{StaticResource MimiAccentSoftBrush}" CornerRadius="6"
                                    Padding="9,4" Visibility="{x:Bind HasQuote}">
                                <TextBlock Text="{x:Bind Quote}" FontSize="12" Foreground="{StaticResource MimiInk2Brush}" TextWrapping="Wrap" MaxLines="3" TextTrimming="CharacterEllipsis" />
                            </Border>
                            <controls:MessageText Text="{x:Bind Text}" TextSize="{x:Bind local:ChatView.ChatTextSize()}" TextBrush="{x:Bind local:ChatView.InkFor(IsUser)}" Visibility="{x:Bind HasText}" />
                            <ItemsControl ItemsSource="{x:Bind Files}" ItemTemplate="{StaticResource FileTemplate}" />
                            <TextBlock Text="{x:Bind Tools}" Style="{StaticResource MimiCaption}" Visibility="{x:Bind local:ChatView.ToolsVisibility(HasTools)}" />
                            <StackPanel Orientation="Horizontal" Spacing="8" Visibility="{x:Bind WaitsForApproval}">
                                <Button Content="อนุมัติ" Style="{StaticResource AccentButtonStyle}" Tag="{x:Bind}" Click="OnApprove" />
                                <Button Content="ปฏิเสธ" Tag="{x:Bind}" Click="OnReject" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <!-- Under the bubble, as the web's .mrow: left for the agent, right for the user. -->
                    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="{x:Bind local:ChatView.Side(IsUser)}">
                        <ItemsControl ItemsSource="{x:Bind ReactionList}" Tag="{x:Bind}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="4" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <Button Content="{x:Bind}" Padding="6,1" MinHeight="0" FontSize="13" CornerRadius="10" Click="OnReactionChip"
                                            ToolTipService.ToolTip="เอารีแอ็กชันออก" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="📌" FontSize="12" VerticalAlignment="Center" Visibility="{x:Bind Pinned}" />
                        <TextBlock Text="{x:Bind Time}" FontSize="11" Foreground="{x:Bind local:ChatView.TimeFor(IsUser)}" VerticalAlignment="Center" />
                        <Button Content="&#xE712;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="11" Padding="4,1" MinHeight="0"
                                Background="Transparent" BorderThickness="0" Foreground="{x:Bind local:ChatView.InkFor(IsUser)}" Tag="{x:Bind}" Click="OnMessageMore"
                                AutomationProperties.Name="ตัวเลือกข้อความ" ToolTipService.ToolTip="ตอบกลับ / ส่งต่อ / คัดลอก / ปักหมุด (หรือคลิกขวาที่ข้อความ)" />
                    </StackPanel>
                </StackPanel>
                </Grid>
            </Grid>
        </DataTemplate>

        <!-- Sent by this device, not echoed yet. -->
        <DataTemplate x:Key="PendingTemplate" x:DataType="vm:PendingItem">
            <Grid Margin="0,6" MaxWidth="840">
                <Grid HorizontalAlignment="Right" MaxWidth="680" Opacity="0.75">
                <Border Background="{x:Bind local:ChatView.UserBubble()}" BorderBrush="{x:Bind local:ChatView.UserBubbleLine()}" BorderThickness="1" CornerRadius="{x:Bind local:ChatView.UserRadius()}" Padding="{x:Bind local:ChatView.UserPadding()}">
                    <StackPanel Spacing="4">
                        <controls:MessageText Text="{x:Bind Text}" TextSize="{x:Bind local:ChatView.ChatTextSize()}" TextBrush="{x:Bind local:ChatView.UserInk()}" />
                        <TextBlock Text="{x:Bind Files}" Style="{StaticResource MimiCaption}" />
                        <TextBlock Text="กำลังส่ง…" FontSize="11" Foreground="{x:Bind local:ChatView.UserTime()}" Visibility="{x:Bind local:ChatView.Not(HasFailed)}" />
                        <TextBlock Text="{x:Bind Failed}" FontSize="12" Foreground="{StaticResource MimiBadBrush}" TextWrapping="Wrap" Visibility="{x:Bind HasFailed}" />
                    </StackPanel>
                </Border>
                </Grid>
            </Grid>
        </DataTemplate>

        <!-- The answer streaming in now. -->
        <DataTemplate x:Key="LiveTemplate" x:DataType="vm:LiveItem">
            <Grid Margin="0,6" MaxWidth="840">
                <Grid HorizontalAlignment="Left" MaxWidth="680">
                <Border Background="{x:Bind local:ChatView.AgentBubble()}" BorderBrush="{x:Bind local:ChatView.AgentBubbleLine()}" BorderThickness="1" CornerRadius="{x:Bind local:ChatView.AgentRadius()}" Padding="{x:Bind local:ChatView.AgentPadding()}">
                    <StackPanel Spacing="6">
                        <TextBlock Text="{x:Bind Who}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource MimiAccentTextBrush}" Visibility="{x:Bind local:ChatView.AgentNameRow()}" />
                        <ProgressRing IsActive="{x:Bind Thinking}" Width="18" Height="18" HorizontalAlignment="Left" Visibility="{x:Bind Thinking}" />
                        <ItemsControl ItemsSource="{x:Bind Parts}" ItemTemplateSelector="{StaticResource PartSelector}" />
                        <TextBlock Text="{x:Bind Helper}" Style="{StaticResource MimiCaption}" Visibility="{x:Bind local:ChatView.HelperVisibility(Helper)}" />
                    </StackPanel>
                </Border>
                </Grid>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="NoteTemplate" x:DataType="vm:NoteItem">
            <TextBlock Text="{x:Bind Text}" Margin="0,4" HorizontalAlignment="Center" TextWrapping="Wrap" FontSize="12"
                       Foreground="{x:Bind local:ChatView.NoteBrush(Bad)}" />
        </DataTemplate>

        <!-- A tool asks before it runs (realtime.md 5). -->
        <DataTemplate x:Key="PermissionTemplate" x:DataType="vm:PermissionItem">
            <Border Margin="0,6" MaxWidth="840" Background="{StaticResource MimiRaisedBrush}" BorderBrush="{StaticResource MimiWarnBrush}" BorderThickness="1" CornerRadius="12" Padding="12,10">
                <StackPanel Spacing="8">
                    <TextBlock Text="{x:Bind Who}" FontSize="12" Foreground="{StaticResource MimiWarnBrush}" FontWeight="SemiBold" />
                    <TextBlock Text="{x:Bind Title}" TextWrapping="Wrap" Foreground="{StaticResource MimiInkBrush}" />
                    <TextBlock Text="{x:Bind Detail}" Style="{StaticResource MimiCaption}" MaxLines="4" IsTextSelectionEnabled="True" />
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Button Content="อนุญาตครั้งนี้" Style="{StaticResource AccentButtonStyle}" Tag="{x:Bind}" Click="OnAllowOnce" AutomationProperties.AutomationId="AllowOnce" />
                        <DropDownButton Content="อนุญาต…" Visibility="{x:Bind CanGrant}">
                            <DropDownButton.Flyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem Text="ตลอดงานนี้" Tag="{x:Bind}" Click="OnAllowTask" />
                                    <MenuFlyoutItem Text="ตลอด session นี้" Tag="{x:Bind}" Click="OnAllowSession" />
                                    <MenuFlyoutItem Text="อนุญาตเสมอ" Tag="{x:Bind}" Click="OnAllowAlways" />
                                </MenuFlyout>
                            </DropDownButton.Flyout>
                        </DropDownButton>
                        <Button Content="ไม่อนุญาต" Tag="{x:Bind}" Click="OnDeny" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- A task card: goal, status, steps, plan / receipt, and its buttons (feature-inventory #10). -->
        <DataTemplate x:Key="TaskTemplate" x:DataType="vm:TaskItem">
            <Border Margin="0,6" MaxWidth="840" Background="{StaticResource MimiRaisedBrush}" BorderBrush="{StaticResource MimiInfoBrush}" BorderThickness="1" CornerRadius="12" Padding="12,10">
                <StackPanel Spacing="6">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="{x:Bind Goal}" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{StaticResource MimiInkBrush}" />
                        <TextBlock Grid.Column="1" Text="{x:Bind StatusLabel}" FontSize="12" Foreground="{StaticResource MimiInfoBrush}" Margin="8,0,0,0" />
                    </Grid>
                    <TextBlock Text="{x:Bind Steps}" FontSize="12" Foreground="{StaticResource MimiInk2Brush}" TextWrapping="Wrap" Visibility="{x:Bind HasSteps}" />
                    <TextBlock Text="{x:Bind Summary}" Style="{StaticResource MimiCaption}" Visibility="{x:Bind HasSummary}" IsTextSelectionEnabled="True" />
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Button Content="หยุดชั่วคราว" Tag="{x:Bind}" Click="OnTaskPause" Visibility="{x:Bind CanPause}" />
                        <Button Content="ทำต่อ" Tag="{x:Bind}" Click="OnTaskResume" Visibility="{x:Bind CanResume}" Style="{StaticResource AccentButtonStyle}" />
                        <Button Content="ยกเลิก" Tag="{x:Bind}" Click="OnTaskCancel" Visibility="{x:Bind CanCancel}" />
                        <Button Content="ย้อนไฟล์กลับ" Tag="{x:Bind}" Click="OnTaskUndo" Visibility="{x:Bind CanUndo}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>

        <local:RowSelector x:Key="RowSelector" Message="{StaticResource MessageTemplate}" Pending="{StaticResource PendingTemplate}" Live="{StaticResource LiveTemplate}"
                           Note="{StaticResource NoteTemplate}" Permission="{StaticResource PermissionTemplate}" Task="{StaticResource TaskTemplate}" />
    </UserControl.Resources>

    <Grid RowDefinitions="Auto,*,Auto,Auto">
        <StackPanel x:Name="ChatHeader">
            <!-- The session on screen, its context meter, and the chat's menu. -->
            <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="4" Padding="12,5,6,5" Background="{StaticResource MimiPanelBrush}"
                  BorderBrush="{StaticResource MimiLineBrush}" BorderThickness="0,0,0,1">
                <StackPanel VerticalAlignment="Center" Spacing="2">
                    <TextBlock AutomationProperties.AutomationId="SessionLabel" Text="{x:Bind ViewModel.SessionLabel, Mode=OneWay}" FontSize="12" Foreground="{StaticResource MimiInk2Brush}" TextTrimming="CharacterEllipsis" />
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <ProgressBar x:Name="ContextMeter" Width="56" Height="4" MinHeight="4" VerticalAlignment="Center" Maximum="100" Visibility="Collapsed" />
                        <TextBlock x:Name="ContextPct" FontFamily="Cascadia Mono, Consolas" FontSize="10.5" Foreground="{StaticResource MimiMutedBrush}" ToolTipService.ToolTip="{x:Bind ViewModel.ContextLabel, Mode=OneWay}" />
                    </StackPanel>
                </StackPanel>
                <Button Grid.Column="1" Content="+ session" Style="{StaticResource MimiGhostButton}" Padding="8,3" FontSize="12" Command="{x:Bind ViewModel.NewSessionCommand}"
                        AutomationProperties.AutomationId="NewSessionButton" ToolTipService.ToolTip="เริ่ม session ใหม่เอง (ปกติระบบเริ่มให้อัตโนมัติเมื่อเงียบไปนาน)" />
                <ToggleButton x:Name="CharacterButton" Grid.Column="2" Content="ตัวละคร" Padding="8,3" FontSize="12" CornerRadius="8" Click="OnCharacter"
                              AutomationProperties.AutomationId="CharacterButton" ToolTipService.ToolTip="แสดง/ซ่อนตัวละครหลังแชตนี้" />
                <Button x:Name="RailButton" Grid.Column="3" Content="ข้อมูล" Style="{StaticResource MimiGhostButton}" Padding="8,3" FontSize="12" Click="OnRail"
                        AutomationProperties.AutomationId="RailButton" ToolTipService.ToolTip="ข้อมูลของแชต สถานะ และหน้าตาของแชตนี้" />
                <DropDownButton x:Name="SessionsButton" Grid.Column="4" Content="&#xE81C;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12" Padding="8,4" AutomationProperties.AutomationId="SessionsButton"
                                AutomationProperties.Name="Session" ToolTipService.ToolTip="session ของแชตนี้">
                    <DropDownButton.Flyout>
                        <MenuFlyout x:Name="SessionsMenu" Placement="BottomEdgeAlignedRight" Opening="OnSessionsOpening" />
                    </DropDownButton.Flyout>
                </DropDownButton>
                <Button x:Name="ChatMenuButton" Grid.Column="5" Style="{StaticResource MimiHeaderButton}" Content="&#xE712;" AutomationProperties.AutomationId="ChatMenuButton"
                        AutomationProperties.Name="ตัวเลือกแชต" ToolTipService.ToolTip="ตัวเลือกแชต">
                    <Button.Flyout>
                        <MenuFlyout x:Name="ChatMenu" Placement="BottomEdgeAlignedRight" Opening="OnChatMenuOpening" />
                    </Button.Flyout>
                </Button>
            </Grid>
            <!-- Pinned messages (feature-chat.js renderPins): click = go to it and show the next. -->
            <Grid ColumnDefinitions="*,Auto" Background="{StaticResource MimiRaisedBrush}" Visibility="{x:Bind ViewModel.HasPins, Mode=OneWay}">
                <Button AutomationProperties.AutomationId="PinBar" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Background="Transparent"
                        BorderThickness="0" Padding="12,4" Command="{x:Bind ViewModel.NextPinCommand}">
                    <StackPanel>
                        <TextBlock Text="{x:Bind ViewModel.PinLabel, Mode=OneWay}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource MimiAccentTextBrush}" />
                        <TextBlock Text="{x:Bind ViewModel.PinText, Mode=OneWay}" FontSize="12" Foreground="{StaticResource MimiInk2Brush}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Button>
                <Button x:Name="PinsMore" Grid.Column="1" Style="{StaticResource MimiHeaderButton}" FontSize="12" Click="OnPinsMore"
                        Content="{x:Bind local:ChatView.PinsGlyph(ViewModel.ManyPins), Mode=OneWay}" AutomationProperties.Name="ปักหมุดทั้งหมด" ToolTipService.ToolTip="ปักหมุดทั้งหมด / เลิกปักหมุด" />
            </Grid>
            <!-- An older session (a search hit, a pin): new messages go to the newest one. -->
            <Grid ColumnDefinitions="*,Auto" Padding="12,2" Background="{StaticResource MimiPanelBrush}" Visibility="{x:Bind ViewModel.OlderSession, Mode=OneWay}">
                <TextBlock Text="กำลังดู session เก่า" Style="{StaticResource MimiCaption}" VerticalAlignment="Center" />
                <HyperlinkButton Grid.Column="1" Content="กลับไป session ล่าสุด" FontSize="12" Command="{x:Bind ViewModel.BackToLatestCommand}" />
            </Grid>
        </StackPanel>

        <Grid x:Name="StageHost" Grid.Row="1" />
        <ListView x:Name="Messages" Grid.Row="1" AutomationProperties.AutomationId="Messages" ItemsSource="{x:Bind ViewModel.Items}" ItemTemplateSelector="{StaticResource RowSelector}"
                  SelectionMode="None" IsItemClickEnabled="False" Padding="10,6,10,6" Background="Transparent">
            <ListView.Header>
                <HyperlinkButton Content="โหลดข้อความก่อนหน้า" HorizontalAlignment="Center" Command="{x:Bind ViewModel.LoadOlderCommand}" Visibility="{x:Bind ViewModel.HasMore, Mode=OneWay}" />
            </ListView.Header>
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="MinHeight" Value="0" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemsPanel>
                <ItemsPanelTemplate>
                    <ItemsStackPanel ItemsUpdatingScrollMode="KeepLastItemInView" VerticalAlignment="Bottom" />
                </ItemsPanelTemplate>
            </ListView.ItemsPanel>
        </ListView>

        <StackPanel x:Name="BottomDock" Grid.Row="2" Grid.RowSpan="2" MaxWidth="840" VerticalAlignment="Stretch" Spacing="0">
        <StackPanel Padding="12,0" Spacing="4">
            <TextBlock Text="{x:Bind ViewModel.Status, Mode=OneWay}" Style="{StaticResource MimiCaption}" Visibility="{x:Bind ViewModel.HasStatus, Mode=OneWay}" />
            <TextBlock AutomationProperties.AutomationId="ChatError" Text="{x:Bind ViewModel.Error, Mode=OneWay}" Foreground="{StaticResource MimiBadBrush}" FontSize="12" TextWrapping="Wrap" />
            <TextBlock AutomationProperties.AutomationId="ChatInfo" Text="{x:Bind ViewModel.Info, Mode=OneWay}" Style="{StaticResource MimiCaption}" Visibility="{x:Bind ViewModel.HasInfo, Mode=OneWay}" />
            <!-- The message the next one answers (feature-chat.js reply bar). -->
            <Grid ColumnDefinitions="*,Auto" Padding="8,4" Background="{StaticResource MimiRaisedBrush}" CornerRadius="6" BorderBrush="{StaticResource MimiAccentBrush}"
                  BorderThickness="3,0,0,0" Visibility="{x:Bind ViewModel.HasReply, Mode=OneWay}">
                <TextBlock AutomationProperties.AutomationId="ReplyBar" Text="{x:Bind ViewModel.ReplyLabel, Mode=OneWay}" FontSize="12" Foreground="{StaticResource MimiInk2Brush}"
                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                <Button Grid.Column="1" Content="&#xE711;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10" Padding="6,3" Background="Transparent" BorderThickness="0"
                        AutomationProperties.Name="ยกเลิกการตอบกลับ" Command="{x:Bind ViewModel.CancelReplyCommand}" />
            </Grid>
            <ItemsControl ItemsSource="{x:Bind ViewModel.Staged}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="6" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="core:AttachmentView">
                        <Button Tag="{x:Bind}" Click="OnUnstage" Padding="8,3" ToolTipService.ToolTip="เอาออก">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="{x:Bind Name}" MaxWidth="160" TextTrimming="CharacterEllipsis" FontSize="12" />
                                <FontIcon Glyph="&#xE711;" FontSize="10" />
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <!-- The web's composer (.composer .box): text on top, attach / mic / emoji / send under it. -->
        <StackPanel x:Name="ComposerArea" Padding="10,4,10,8" Spacing="3">
            <Border x:Name="ComposerBox" Background="{StaticResource MimiPanelBrush}" BorderBrush="{StaticResource MimiLineStrongBrush}" BorderThickness="1" CornerRadius="14" Padding="6,4,6,6">
                <!-- The web's mobile order: mic, attach, text, emoji, send; no send while there is nothing to send. -->
                <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto" ColumnSpacing="2">
                    <ToggleButton x:Name="MicButton" Content="&#xE720;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Background="Transparent" BorderThickness="0"
                                  ToolTipService.ToolTip="อัดข้อความเสียง (กดอีกครั้งเพื่อส่ง)" AutomationProperties.Name="อัดเสียง" Click="OnMic" VerticalAlignment="Bottom"
                                  Visibility="{x:Bind local:ChatView.MicVisibility(ViewModel.CanSend, ViewModel.Busy), Mode=OneWay}" />
                    <Button x:Name="AttachButton" Grid.Column="1" Style="{StaticResource MimiHeaderButton}" Content="&#xE723;" ToolTipService.ToolTip="แนบไฟล์" AutomationProperties.Name="แนบไฟล์" Click="OnAttach" VerticalAlignment="Bottom"
                            Foreground="{StaticResource MimiMutedBrush}" />
                    <TextBox Grid.Column="2" x:Name="Composer" AutomationProperties.AutomationId="Composer" AutomationProperties.Name="พิมพ์ข้อความ"
                             PlaceholderText="พิมพ์ข้อความ…" AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="160" BorderThickness="0" Background="Transparent"
                             Text="{x:Bind ViewModel.Draft, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PreviewKeyDown="OnComposerKey" IsSpellCheckEnabled="False" />
                    <Button Grid.Column="3" x:Name="EmojiButton" Content="🙂" Background="Transparent" BorderThickness="0" Padding="6,4" VerticalAlignment="Bottom"
                            AutomationProperties.Name="อีโมจิ" ToolTipService.ToolTip="อีโมจิ (หรือกด Win + .)">
                        <Button.Flyout>
                            <Flyout x:Name="EmojiFlyout" Placement="Top">
                                <GridView x:Name="EmojiGrid" SelectionMode="None" IsItemClickEnabled="True" ItemClick="OnEmoji" MaxWidth="330" MaxHeight="260" />
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                    <Grid x:Name="SendHost" Grid.Column="4" VerticalAlignment="Bottom">
                        <Button x:Name="SendButton" AutomationProperties.AutomationId="SendButton" Style="{StaticResource AccentButtonStyle}" Content="&#xE724;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                CornerRadius="10" Padding="9,7" AutomationProperties.Name="ส่ง" Command="{x:Bind ViewModel.SendCommand}" IsEnabled="{x:Bind ViewModel.CanSend, Mode=OneWay}"
                                Visibility="{x:Bind local:ChatView.SendVisibility(ViewModel.CanSend, ViewModel.Busy), Mode=OneWay}" />
                        <Button x:Name="StopButton" AutomationProperties.AutomationId="StopButton" Content="&#xE71A;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" AutomationProperties.Name="หยุด"
                                CornerRadius="10" Padding="9,7" ToolTipService.ToolTip="หยุด" Command="{x:Bind ViewModel.StopCommand}" Visibility="{x:Bind ViewModel.Busy, Mode=OneWay}" />
                    </Grid>
                </Grid>
            </Border>
            <TextBlock x:Name="ComposerHint" Text="Enter ส่ง · Shift+Enter ขึ้นบรรทัดใหม่" FontSize="11" Foreground="{StaticResource MimiFaintBrush}" Margin="8,0,0,0" />
        </StackPanel>
        </StackPanel>

        <!-- Character chat (web .solo): the stage runs behind everything; glass buttons and pins float on top. -->
        <StackPanel x:Name="SoloBar" Grid.Row="1" Grid.RowSpan="3" Padding="12,10,12,0" VerticalAlignment="Top" Spacing="8" Visibility="Collapsed">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <Button x:Name="SoloBack" Style="{StaticResource MimiGlassCircleButton}" Content="≡" FontFamily="Segoe UI" FontSize="24"
                        AutomationProperties.AutomationId="BackButton" AutomationProperties.Name="กลับ" ToolTipService.ToolTip="กลับไปรายการแชต" Click="OnSoloBack" />
                <Button x:Name="SoloSettings" Grid.Column="2" Style="{StaticResource MimiGlassCircleButton}" Content="&#xE713;"
                        FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="17" AutomationProperties.AutomationId="RailButton"
                        AutomationProperties.Name="ข้อมูล" ToolTipService.ToolTip="ข้อมูลและหน้าตาของแชตนี้" Click="OnRail" />
            </Grid>
            <!-- The pin bar of the normal header, the same data, floating over the stage (mobile .solo .pinbar). -->
            <Border Background="{StaticResource MimiGlassPanelBrush}" BorderBrush="{StaticResource MimiGlassButtonLineBrush}" BorderThickness="1"
                    CornerRadius="16" Visibility="{x:Bind ViewModel.HasPins, Mode=OneWay}">
                <Grid ColumnDefinitions="*,Auto">
                    <Button AutomationProperties.AutomationId="PinBar" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Background="Transparent"
                            BorderThickness="0" Padding="12,4" Command="{x:Bind ViewModel.NextPinCommand}">
                        <StackPanel>
                            <TextBlock Text="{x:Bind ViewModel.PinLabel, Mode=OneWay}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource MimiAccentTextBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.PinText, Mode=OneWay}" FontSize="12" Foreground="{StaticResource MimiInk2Brush}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="1" Style="{StaticResource MimiHeaderButton}" FontSize="12" Click="OnPinsMore"
                            Content="{x:Bind local:ChatView.PinsGlyph(ViewModel.ManyPins), Mode=OneWay}" AutomationProperties.Name="ปักหมุดทั้งหมด" ToolTipService.ToolTip="ปักหมุดทั้งหมด / เลิกปักหมุด" />
                </Grid>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>
