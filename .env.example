# --- Model providers ---------------------------------------------------------
# The usual way is the app's settings screen: add a provider (name + URL + API key),
# the app lists its models and stores the credential in user/data/auth.json.
# Keys set here work too, for providers known to models.dev (e.g. OPENCODE_API_KEY).
DEEPSEEK_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
ANTHROPIC_API_KEY=

# --- Server (npm run serve) --------------------------------------------------
# Shared secret for every client and the PC agent. Leave empty for a one-time token
# that is printed at start. Use a long random value when the core is reachable from
# outside this machine.
MIMI_TOKEN=
# MIMI_HOST=127.0.0.1      # 0.0.0.0 to accept connections from other devices
# PORT=8787
# Behind a reverse proxy that overwrites this header with the caller's address
# (Railway: x-real-ip). Leave unset when clients connect directly.
# MIMI_CLIENT_IP_HEADER=x-real-ip
# Contact sent to push services with each notification (a real address of yours).
# MIMI_PUSH_CONTACT=mailto:you@example.com

# --- Accounts gateway (several people, one core service each; docs/hosting.md) ---
# MIMI_MODE=gateway                 # this process is the gateway, not a core
# MIMI_GATEWAY_SECRET=              # >= 32 random characters; encrypts the cores' tokens
# MIMI_SESSION_IDLE_DAYS=30         # sign in again after this many days without use
# MIMI_SESSION_MAX_DAYS=90          # and in any case this many days after signing in
# MIMI_ACCOUNTS_DB=                 # default: <user folder>/data/accounts.db

# --- Files and shell ---------------------------------------------------------
# Folders the file/shell tools may touch, separated by ";". Defaults to ./user/workspace
ALLOWED_DIRS=
# Set to 0 on a cloud core: file/shell tools then only work through a connected PC agent.
# MIMI_LOCAL_PC_TOOLS=1

# --- PC agent (npm run pc-agent, on your own computer) ------------------------
# Uses MIMI_TOKEN and ALLOWED_DIRS from above, plus where the core is:
# MIMI_CORE_URL=ws://127.0.0.1:8787/ws

# --- Gmail and Google Calendar ------------------------------------------------
# Create a "Desktop app" OAuth client in Google Cloud Console, paste the two values
# here, then run:  npm run google-auth
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Optional: instead of the token file written by google-auth
# GOOGLE_OAUTH_REFRESH_TOKEN=

# --- Packs ---------------------------------------------------------------------
# Optional remote catalog: an https JSON array of packs (or {"packs": [...]}).
# Entries are validated like a pack file and shown as "remote" in Hub > แพ็ก.
# There is no signature; only point this at a source you trust.
# MIMI_PACK_CATALOG_URL=https://example.com/mimi-packs.json

# --- Public tunnel (webhooks / calendar push) ----------------------------------
# Quick tunnel: no account, address changes every start.
# MIMI_CLOUDFLARED=C:\path\to\cloudflared.exe
# Named tunnel: a stable hostname from your Cloudflare account (cloudflared tunnel create).
# MIMI_CLOUDFLARED_TUNNEL=mimi
# MIMI_CLOUDFLARED_URL=https://mimi.example.com   # or a hostname in the config below
# MIMI_CLOUDFLARED_CONFIG=/full/path/.cloudflared/config.yml
# MIMI_CLOUDFLARED_AUTOSTART=0                   # default: start a named tunnel with the core

# --- Realtime calendar (Google / Outlook) -------------------------------------
# Push notifications need a public HTTPS address that Graph and Google can call.
# On this computer that means a tunnel (e.g. cloudflared) or the accounts gateway:
#   MIMI_CALENDAR_PUBLIC_URL=https://<tunnel-host>              (cloudflared/ngrok)
#   MIMI_CALENDAR_PUBLIC_URL=https://<gateway>/h/<route-id>     (behind the gateway)
# MIMI_PUBLIC_URL is used when this is not set. Without either, Mimi keeps working
# with a delta poll every 15 minutes (no push subscription).
# MIMI_CALENDAR_SYNC=0          # turn the calendar watcher off completely
# MIMI_CALENDAR_SYNC_MINUTES=15 # safety-net delta poll and subscription renewal tick

# --- Outlook mail, Outlook calendar, Microsoft To Do ---------------------------
# Usually set in the app (Settings). Register your own app in Azure Portal ->
# App registrations, add the platform "Mobile and desktop applications" with the
# redirect URI http://localhost, and use its Application (client) ID. No secret needed.
# MICROSOFT_CLIENT_ID=
# MICROSOFT_TENANT=common

# --- Web tools ------------------------------------------------------------------
# Usually set in the app (Settings -> tool keys).
# SERPER_API_KEY=           # web_search and map_search (serper.dev)
# OPENWEATHER_API_KEY=      # weather (openweathermap.org)

# --- Optional overrides ---------------------------------------------------------
# MIMI_CONFIG=mimi.json
# MIMI_DB=user/data/mimi.db
# MIMI_TIMEZONE=Asia/Bangkok
# PERMISSION_TIMEOUT_MS=120000
# MIMI_MODELS_OFFLINE=1   # never download the models.dev catalog, use the cached copy only
# Desktop apps the native computer tools may control; empty = none, * = all
# MIMI_ALLOWED_APPS=Mail;Microsoft Outlook;Thunderbird
# Background tasks are opt-in; set to 1 to allow task_run background jobs
# MIMI_ALLOW_BACKGROUND_TASKS=1
# Folder of songs for Mimiamp (default: packages/core/src/server/web/mimiamp)
# MIMI_MUSIC_DIR=
