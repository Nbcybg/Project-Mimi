{
  "name": "Lead intake",
  "flow": [
    {
      "id": 1,
      "module": "gateway:CustomWebHook",
      "version": 2,
      "parameters": {},
      "mapper": {},
      "metadata": {
        "designer": {
          "x": 0,
          "y": 0,
          "name": "Webhook"
        }
      }
    },
    {
      "id": 2,
      "module": "http:ActionSendData",
      "version": 3,
      "parameters": {},
      "mapper": {
        "url": "https://api.example.com/v1/leads/{{1.id}}",
        "method": "get",
        "headers": [
          {
            "name": "Authorization",
            "value": "Bearer demo-placeholder-token-not-real"
          },
          {
            "name": "Accept",
            "value": "application/json"
          }
        ]
      },
      "metadata": {
        "designer": {
          "x": 300,
          "y": 0,
          "name": "Fetch profile"
        }
      }
    },
    {
      "id": 3,
      "module": "builtin:BasicFilter",
      "version": 1,
      "parameters": {},
      "mapper": {},
      "filter": {
        "name": "Has email",
        "conditions": [
          [
            {
              "a": "{{2.email}}",
              "b": "",
              "o": "text:exist"
            }
          ]
        ]
      },
      "metadata": {
        "designer": {
          "x": 600,
          "y": 0,
          "name": "Has email"
        }
      }
    },
    {
      "id": 4,
      "module": "google-sheets:addRow",
      "version": 2,
      "parameters": {
        "__IMTCONN__": 98765
      },
      "mapper": {
        "spreadsheetId": "sheet-demo",
        "sheetName": "Leads",
        "values": {
          "0": "{{2.name}}",
          "1": "{{2.email}}"
        }
      },
      "metadata": {
        "designer": {
          "x": 900,
          "y": 0,
          "name": "Log lead"
        }
      }
    },
    {
      "id": 5,
      "module": "slack:sendMessage",
      "version": 1,
      "parameters": {
        "__IMTCONN__": 12345
      },
      "mapper": {
        "channel": "#leads",
        "text": "New lead: {{2.name}}"
      },
      "metadata": {
        "designer": {
          "x": 1200,
          "y": 0,
          "name": "Notify Slack"
        }
      }
    },
    {
      "id": 6,
      "module": "builtin:BasicRouter",
      "version": 1,
      "parameters": {},
      "mapper": null,
      "metadata": {
        "designer": {
          "x": 1500,
          "y": 0,
          "name": "Fallback"
        }
      },
      "routes": [
        {
          "flow": [
            {
              "id": 7,
              "module": "code:ExecuteCode",
              "version": 1,
              "parameters": {},
              "mapper": {
                "code": "return { ok: true };"
              },
              "metadata": {
                "designer": {
                  "x": 1800,
                  "y": 150,
                  "name": "Shape fallback"
                }
              }
            }
          ]
        }
      ]
    }
  ],
  "metadata": {
    "version": 1,
    "scenario": {
      "maxErrors": 3,
      "autoCommit": true
    },
    "designer": {
      "orphans": []
    }
  }
}
