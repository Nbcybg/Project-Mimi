<UserControl
    x:Class="Mimi.App.Views.InboxView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Mimi.Core.ViewModels"
    xmlns:local="using:Mimi.App.Views">
    <Grid RowDefinitions="Auto,*">
        <Grid ColumnDefinitions="*,Auto" Padding="14,8,12,4">
            <TextBlock Text="{x:Bind ViewModel.Heading, Mode=OneWay}" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{StaticResource MimiInkBrush}" />
            <Button Grid.Column="1" Content="อ่านทั้งหมด" AutomationProperties.AutomationId="ReadAllButton" Command="{x:Bind ViewModel.ReadAllCommand}"
                    Visibility="{x:Bind ViewModel.HasUnread, Mode=OneWay}" />
        </Grid>
        <ListView Grid.Row="1" AutomationProperties.AutomationId="InboxList" ItemsSource="{x:Bind ViewModel.Rows}" SelectionMode="None"
                  IsItemClickEnabled="True" ItemClick="OnItemClick" Padding="4,0,4,8">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:InboxRow">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" Padding="4,8" Opacity="{x:Bind local:InboxView.Dim(Unread)}" AutomationProperties.Name="{x:Bind Title}">
                        <TextBlock Text="{x:Bind Icon}" FontSize="16" VerticalAlignment="Top" />
                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{StaticResource MimiInkBrush}" />
                            <TextBlock Text="{x:Bind Body}" FontSize="13" Foreground="{StaticResource MimiMutedBrush}" TextWrapping="Wrap" MaxLines="3" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Spacing="4">
                            <TextBlock Text="{x:Bind When}" Style="{StaticResource MimiCaption}" HorizontalAlignment="Right" />
                            <Ellipse Width="9" Height="9" Fill="{StaticResource MimiAccentBrush}" HorizontalAlignment="Right" Visibility="{x:Bind Unread}" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        <TextBlock Grid.Row="1" Text="ยังไม่มีการแจ้งเตือน" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource MimiMutedBrush}"
                   Visibility="{x:Bind ViewModel.Empty, Mode=OneWay}" />
    </Grid>
</UserControl>
