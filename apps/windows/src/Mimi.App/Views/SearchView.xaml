<UserControl
    x:Class="Mimi.App.Views.SearchView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Mimi.Core.ViewModels"
    xmlns:controls="using:Mimi.App.Controls">
    <Grid RowDefinitions="Auto,Auto,*">
        <TextBox x:Name="Field" Margin="12,8,12,4" AutomationProperties.AutomationId="SearchField" AutomationProperties.Name="ค้นหา"
                 PlaceholderText="ค้นหาในทุกแชตและทุก session…" IsSpellCheckEnabled="False"
                 Text="{x:Bind ViewModel.Query, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" TextChanged="OnTextChanged" KeyDown="OnKey" />
        <TextBlock Grid.Row="1" Margin="14,0,14,4" Text="{x:Bind ViewModel.Status, Mode=OneWay}" Style="{StaticResource MimiCaption}" />
        <ListView Grid.Row="2" AutomationProperties.AutomationId="SearchResults" ItemsSource="{x:Bind ViewModel.Results}" SelectionMode="None"
                  IsItemClickEnabled="True" ItemClick="OnHitClick" Padding="4,0,4,8">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:SearchRow">
                    <StackPanel Padding="4,8" Spacing="2" AutomationProperties.Name="{x:Bind Snippet}">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <TextBlock Text="{x:Bind Where}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource MimiAccentTextBrush}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="1" Text="{x:Bind When}" Style="{StaticResource MimiCaption}" />
                        </Grid>
                        <controls:HighlightText Row="{x:Bind}" />
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</UserControl>
